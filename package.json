{
  "name": "pi-harness",
  "version": "0.1.0",
  "description": "Lightweight headless agent harness built on pi-agent-core and pi-ai",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./storage/memory": {
      "types": "./dist/store/memory.d.ts",
      "import": "./dist/store/memory.js"
    },
    "./storage/jsonl": {
      "types": "./dist/store/jsonl/index.d.ts",
      "import": "./dist/store/jsonl/index.js"
    },
    "./storage/jsonl/node": {
      "types": "./dist/store/jsonl/node.d.ts",
      "import": "./dist/store/jsonl/node.js"
    },
    "./storage/indexeddb": {
      "types": "./dist/store/indexeddb.d.ts",
      "import": "./dist/store/indexeddb.js"
    },
    "./storage/sqlite": {
      "types": "./dist/store/sqlite/index.d.ts",
      "import": "./dist/store/sqlite/index.js"
    },
    "./storage/sqlite/node": {
      "types": "./dist/store/sqlite/node.d.ts",
      "import": "./dist/store/sqlite/node.js"
    },
    "./storage/sqlite/bun": {
      "types": "./dist/store/sqlite/bun.d.ts",
      "import": "./dist/store/sqlite/bun.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "DESIGN.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "build:bun-verify": "bun build --compile --no-compile-autoload-bunfig --no-compile-autoload-dotenv ./scripts/verify-bun-host.ts --outfile dist/verify-bun-host",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && vitest run",
    "test:bun": "bun test test/bun-sqlite.bun.test.ts",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^1.6.0",
    "@earendil-works/pi-ai": "^1.6.0",
    "@earendil-works/pi-schema": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "fake-indexeddb": "^6.2.8",
    "typescript": "^5.8.3",
    "vitest": "^4.1.12"
  }
}
